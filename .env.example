# Eagle AI — environment variables
# Copy this file to `.env` and fill in real values.
#
# Variables prefixed with VITE_ are inlined into the client bundle at build
# time, so they're visible to anyone who inspects the page. Only put values
# that are safe to expose (Firebase web config, public Maps key, etc.).
#
# Variables WITHOUT the VITE_ prefix are read server-side by the Vercel
# functions in /api and never reach the browser. Put real secrets here.

# ─── Server-side (private) ───────────────────────────────────────────────────

# Anthropic API key used by /api/chat for the Caddie advice, Coach chat,
# and Eagle Vision photo analysis. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# GolfAPI.io key used by /api/golfapi for course coordinates and tee data.
GOLF_API_KEY=

# Optional: golfcourseapi.com key used by /api/golfcourseapi as a fallback
# course-data source.
GOLF_COURSE_API_KEY=

# ─── Client-side (public) ────────────────────────────────────────────────────

# Google Maps JavaScript API key for the satellite hole map. Lock this down
# to your domain in the Google Cloud console.
VITE_GOOGLE_MAPS_KEY=

# Firebase web app config — these are public by design. Get them from the
# Firebase console under Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# GolfAPI key used client-side as a fallback when the server proxy is
# unavailable. Same value as GOLF_API_KEY above.
VITE_GOLF_API_KEY=
